# The Django backend that "npm run dev" and "npm run preview" send /api requests to.
# To use Django on your own PC instead, create a file named .env.local containing:
#   BACKEND_URL=http://127.0.0.1:8000
#
# The app hosted on Vercel does not use this file: its /api forwarding is in vercel.json.
# If the backend address changes, update it in both places.
BACKEND_URL=https://aswathiashoke.pythonanywhere.com
